# Copy to .env for local development. Validated by zod at boot; the process
# refuses to start on invalid config (§11.3).

# NODE_ENV is deliberately ABSENT. Each tool sets it for what it is doing:
# `next build` needs production, the dev server needs development, Vitest sets
# test. Pinning it here exports development into every command, and
# `next build` then prerenders with React's development build and fails on its
# own /_global-error page. A project .env has no business deciding this.

# PostgreSQL — the sole durable truth (ADR-009).
DATABASE_URL="postgresql://globalidle:globalidle@localhost:5432/globalidle?schema=public"

# The least-privileged application role used at runtime. It has no UPDATE or
# DELETE on the ledger table (I6, §6.4) — that grant is revoked by migration.
DATABASE_APP_URL="postgresql://globalidle_app:globalidle_app@localhost:5432/globalidle?schema=public"

# Redis — holds nothing that cannot be rebuilt from PostgreSQL (§11.1).
REDIS_URL="redis://localhost:6379"

API_PORT="3001"
LOG_LEVEL="info"

# ONE HOST CONVENTION FOR THE BROWSER: 127.0.0.1.
#
# The session cookie is stored against a HOST, and SameSite=Lax compares the
# site of a request with the site of the page that made it. `localhost` and
# `127.0.0.1` are different hosts and therefore different sites, so a page
# served from one calling an API on the other sends no cookie at all — a
# silent 401 with nothing in the network panel to explain it.
#
# So: open the game at http://127.0.0.1:3000, not http://localhost:3000.

# Origins the browser may call the API from, with credentials. An explicit
# LIST, never a wildcard: `*` and credentials are mutually exclusive.
WEB_ORIGINS="http://127.0.0.1:3000"

# The origin the API is served on, as the BROWSER sees it. It decides the
# session cookie's security attributes: `Secure` is omitted on loopback HTTP
# and required everywhere else. An http:// origin on a NON-loopback host is a
# boot failure — a session in the clear is not something to ship quietly.
PUBLIC_ORIGIN="http://127.0.0.1:3001"

# Content bundle root for the local filesystem provider (§7.7). A relative
# path is resolved against the PROCESS WORKING DIRECTORY, which is why the api
# and worker start scripts run from the repository root: one relative default
# has to mean the same thing to both.
CONTENT_BUNDLE_DIR="./packages/game-data/bundles"
